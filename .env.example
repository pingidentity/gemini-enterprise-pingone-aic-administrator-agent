# Local development settings. Copy to .env; never commit credential values.
# For customer deployments, use deployment.env.example and --env-file instead.
# --- PingAIC tenant ---
# Tenant base URL, no trailing slash.
PING_BASE_URL=https://your-tenant.forgeblocks.com

# Realm used by IDM and AM API paths. Alpha for most tenants.
PING_REALM=alpha

# Space-separated OAuth scopes requested by the service account.
PING_SCOPES="fr:idm:* fr:am:*"

# --- PingOne AIC service-account authentication ---
# Local development only: provide both plaintext values in .env (never commit
# this file). PING_ADMIN_SERVICE_ACCOUNT_ID is the PingAIC service-account ID,
# not the GCP runtime service account.
PING_ADMIN_SERVICE_ACCOUNT_ID=
# JSON object containing the RSA private JWK. It must include kty=RSA, n, e,
# and d. Optional kid is copied into the JWT header. Never log or check in it.
PING_ADMIN_PRIVATE_JWK=

# Agent Runtime: provide both Secret Manager resource names, for example
# projects/<project>/secrets/pingaic-admin-service-account-id/versions/latest
# and projects/<project>/secrets/pingaic-admin-private-jwk/versions/latest.
# The runtime GCP service account reads these through ADC at startup.
PING_ADMIN_SERVICE_ACCOUNT_ID_SECRET=
PING_ADMIN_PRIVATE_JWK_SECRET=

# Monitoring/audit API credentials are a separate pair used only by
# GET /monitoring/logs. For local-only testing, set both plaintext values;
# deployed runtimes must set only the Secret Manager resource names.
PING_ADMIN_AUDIT_API_KEY=
PING_ADMIN_AUDIT_API_SECRET=
PING_ADMIN_AUDIT_API_KEY_SECRET=
PING_ADMIN_AUDIT_API_SECRET_SECRET=
# Optional documented audit payload path for username filtering. Leave unset
# until confirmed for the target tenant; the client refuses to guess.
PING_ADMIN_AUDIT_USERNAME_FIELD=

# --- Optional overrides ---
# Defaults to https://<tenant-host>:443/am/oauth2/access_token. The override is
# also used verbatim as the JWT aud claim.
PING_TOKEN_URL=

# A2UI v0.9 renders the administration workspace for compatible A2A clients.
# Set false/0/no to disable it. Restart the process after changing this setting.
PING_ADMIN_A2UI_ENABLED=true
# true opens Material workspaces in the Gemini Enterprise side panel (Canvas);
# false renders them inline in the chat stream.
PING_ADMIN_A2UI_PANEL=true
# conversation refreshes one side-panel surface in place; turn opens a new one
# for every response.
PING_ADMIN_A2UI_SURFACE=conversation
# Local single-process development keeps UI state in memory. Deployed runtimes
# use sqlite so the instance's worker processes share controls and approvals.
PING_ADMIN_STATE_STORE=memory

# Optional public HTTPS copy of the official Ping Identity SVG logo.
# Empty uses Ping Identity's website. Used by A2A iconUrl and the A2UI header.
PING_ADMIN_LOGO_URL=
# true shows that logo in the side-panel header; false shows an icon instead.
PING_ADMIN_CANVAS_LOGO=false

# --- Local model backend (ADC) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
PING_ADMIN_MODEL=gemini-3.5-flash
# Model endpoint only; independent of the runtime/Sessions region above.
# Use a supported endpoint such as us or eu when required by customer policy.
PING_ADMIN_MODEL_LOCATION=global
