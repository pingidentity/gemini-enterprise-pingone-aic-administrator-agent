# Copy to deployment.env. Used explicitly with --env-file deployment.env.
# Existing shell variables take precedence. Never put plaintext credentials here.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
STAGING_BUCKET=gs://your-agent-staging-bucket
PING_ADMIN_SERVICE_ACCOUNT=ping-aic-admin-agent@your-project-id.iam.gserviceaccount.com

PING_BASE_URL=https://your-tenant.forgeblocks.com
PING_REALM=alpha
PING_ADMIN_MODEL=gemini-3.5-flash
# Model endpoint only; GOOGLE_CLOUD_LOCATION remains the runtime/Sessions region.
# Use a supported endpoint such as us or eu when required by customer policy.
PING_ADMIN_MODEL_LOCATION=global
PING_SCOPES="fr:idm:* fr:am:*"
PING_ADMIN_SERVICE_ACCOUNT_ID_SECRET=projects/your-project-id/secrets/pingaic-admin-service-account-id/versions/latest
PING_ADMIN_PRIVATE_JWK_SECRET=projects/your-project-id/secrets/pingaic-admin-private-jwk/versions/latest
PING_ADMIN_AUDIT_API_KEY_SECRET=projects/your-project-id/secrets/pingaic-admin-audit-key/versions/latest
PING_ADMIN_AUDIT_API_SECRET_SECRET=projects/your-project-id/secrets/pingaic-admin-audit-secret/versions/latest
# Optional, once confirmed against the customer's audit payload.
PING_ADMIN_AUDIT_USERNAME_FIELD=
PING_ADMIN_A2UI_ENABLED=true
# true opens Material workspaces in the Gemini Enterprise side panel (Canvas)
# with an opener card in the chat; false renders them inline in the chat.
PING_ADMIN_A2UI_PANEL=true
# conversation keeps one side-panel surface per conversation and refreshes it in
# place; turn opens a new surface (and opener card) for every response.
PING_ADMIN_A2UI_SURFACE=conversation
# UI controls, approvals and A2A tasks are shared by the instance's worker
# processes through a SQLite file on its local disk. Managed deployments
# require sqlite; memory is for single-process local development only.
PING_ADMIN_STATE_STORE=sqlite
# Directory for that file inside the instance; empty uses the temp directory.
PING_ADMIN_STATE_DIR=
# Optional public HTTPS copy of the official Ping Identity SVG logo.
# Empty uses Ping Identity's website. The agent endpoint stays authenticated.
PING_ADMIN_LOGO_URL=
# true shows that logo in the side-panel header through the basic A2UI Image
# component; false shows an icon instead. Off until confirmed in Gemini Enterprise.
PING_ADMIN_CANVAS_LOGO=false
